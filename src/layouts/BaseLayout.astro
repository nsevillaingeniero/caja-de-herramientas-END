---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/work-sans';
import '../styles/global.css';

import { SITE } from '../config/site.mjs';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchDialog from '../components/search/SearchDialog.astro';

interface Props {
  title: string;
  description?: string;
  /** Imagen social. Si no se da, se usa la genérica del sitio. */
  image?: string;
  /** Evita indexar páginas de resultados o utilitarias. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  noindex = false,
} = Astro.props;

// Título completo: evita duplicar el nombre en la home.
const fullTitle = title === SITE.name ? `${SITE.name} · ${SITE.institutionShort}` : `${title} · ${SITE.name}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const socialImage = image ? new URL(image, Astro.site ?? SITE.url).href : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#016cb6" />

    <script is:inline>
      // Se marca antes de pintar para evitar un parpadeo del contenido.
      // Si este script no corre, `.reveal` no oculta nada y todo se ve.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Salto directo al contenido: primer elemento tabulable de la página. -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-end-700 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />

    <SearchDialog />

    <script>
      // Aparición progresiva al entrar en viewport.
      // Solo actúa si el script inline marcó <html> como capaz de animar.
      const targets = document.querySelectorAll('.reveal');

      if (!document.documentElement.classList.contains('js-reveal')) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -5% 0px', threshold: 0.01 },
        );

        targets.forEach((el) => observer.observe(el));
      }

      // Red de seguridad: si algo impidiera revelar el contenido,
      // se muestra igualmente pasado un momento.
      window.setTimeout(() => {
        document
          .querySelectorAll('.reveal:not(.is-visible)')
          .forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight) el.classList.add('is-visible');
          });
      }, 1200);
    </script>
  </body>
</html>
