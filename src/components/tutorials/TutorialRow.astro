---
import Icon from '../primitives/Icon.astro';
import { formatDuration, LEVEL_LABELS, type Tutorial } from '../../lib/content';

/**
 * Un tutorial dentro de una ruta.
 *
 * Los tutoriales se leen mejor como una secuencia numerada que como
 * una rejilla de miniaturas: el docente ve por dónde empieza, cuánto
 * dura y qué viene después. El número es el orden real dentro de su
 * categoría, no un adorno.
 */
interface Props {
  tutorial: Tutorial;
  index: number;
  onDark?: boolean;
  class?: string;
}

const { tutorial, index, onDark = false, class: className = '' } = Astro.props;
const { data } = tutorial;
---

<a
  href={`/end-digital/${tutorial.id}/`}
  class:list={[
    'group flex items-center gap-4 py-5 transition-colors duration-300 sm:gap-6',
    className,
  ]}
>
  <span
    aria-hidden="true"
    class:list={[
      'tabular w-7 shrink-0 font-display text-sm font-bold transition-colors duration-300',
      onDark
        ? 'text-white/40 group-hover:text-teal-300'
        : 'text-ink-muted group-hover:text-teal-700',
    ]}
  >
    {String(index).padStart(2, '0')}
  </span>

  <span class="min-w-0 flex-1">
    <span
      class:list={[
        'block font-display text-lg leading-snug font-bold',
        onDark ? 'text-white' : 'text-end-900',
      ]}
    >
      <span class="link-underline">{data.title}</span>
    </span>
    <span
      class:list={[
        'mt-1.5 block text-sm leading-relaxed',
        onDark ? 'text-white/60' : 'text-ink-soft',
      ]}
    >
      {data.description}
    </span>
  </span>

  <span
    class:list={[
      'hidden shrink-0 items-center gap-2.5 text-sm sm:flex',
      onDark ? 'text-white/60' : 'text-ink-muted',
    ]}
  >
    <span>{LEVEL_LABELS[data.level]}</span>
    <span aria-hidden="true">·</span>
    <span class="tabular">{formatDuration(data.duration)}</span>
  </span>

  <Icon
    name={data.video ? 'circle-play' : 'arrow'}
    class:list={[
      'size-5 shrink-0 transition-all duration-300 group-hover:translate-x-1',
      onDark
        ? 'text-white/50 group-hover:text-teal-300'
        : 'text-ink-muted group-hover:text-teal-700',
    ]}
  />
</a>
