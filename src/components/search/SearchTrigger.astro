---
import Icon from '../primitives/Icon.astro';

/**
 * Disparador de la búsqueda global en el header.
 * El diálogo real se monta una sola vez en SearchDialog.
 */
---

<button
  type="button"
  data-search-open
  class="group flex items-center gap-2.5 rounded-control px-3 py-2 text-sm text-ink-muted ring-1 ring-inset ring-border-strong transition-colors hover:text-end-800 hover:ring-end-600 sm:w-52 lg:w-60"
>
  <Icon name="search" class="size-4 shrink-0" />
  <span class="hidden sm:inline">Buscar</span>
  <span class="sr-only sm:hidden">Buscar en la plataforma</span>
  <kbd
    class="ml-auto hidden rounded-[3px] bg-paper-deep px-1.5 py-0.5 font-sans text-[10px] font-bold text-ink-muted lg:inline-block"
  >
    /
  </kbd>
</button>
