---
import Icon from '../primitives/Icon.astro';
import {
  AUDIENCE_LABELS,
  TRACK_LABELS,
  isPastTraining,
  type Training,
} from '../../lib/content';

/**
 * Una sesión del plan de capacitación.
 *
 * La ficha tiene tres estados y se leen de un vistazo:
 *
 *   · Con grabación  → botón sólido: es la acción principal.
 *   · Ya realizada sin grabación → se dice que está pendiente, en vez
 *     de dejar un hueco que parezca un error.
 *   · Por venir → manda la fecha y el horario de los grupos.
 *
 * Publicar una grabación es añadir `recording.url` en el JSON de la
 * sesión: la ficha cambia de estado sola.
 */
interface Props {
  training: Training;
  index: number;
  class?: string;
}

const { training, index, class: className = '' } = Astro.props;
const { data } = training;

const past = isPastTraining(training);
const recording = data.recording;
---

<article
  data-training
  data-track={data.track}
  data-audience={data.audience ?? ''}
  data-recording={recording ? 'si' : 'no'}
  data-state={recording ? 'grabada' : past ? 'pendiente' : 'proxima'}
  class:list={[
    'group lift relative flex h-full flex-col overflow-hidden rounded-panel bg-white p-6 shadow-float ring-1 ring-border lg:p-8',
    className,
  ]}
>
  <span
    aria-hidden="true"
    class:list={[
      'absolute inset-y-0 left-0 w-0 transition-all duration-400 ease-out-soft group-hover:w-1.5',
      recording ? 'bg-teal-500' : 'bg-end-500',
    ]}
  ></span>

  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="flex flex-wrap items-center gap-2 text-xs">
        <span
          aria-hidden="true"
          class="tabular font-display text-sm font-bold text-ink-muted"
        >
          {String(index).padStart(2, '0')}
        </span>
        <span
          class="rounded-full bg-end-50 px-2.5 py-1 font-semibold text-end-800"
        >
          {TRACK_LABELS[data.track]}
        </span>
        {
          data.audience && (
            <span class="rounded-full bg-paper px-2.5 py-1 font-medium text-ink-soft ring-1 ring-border">
              {AUDIENCE_LABELS[data.audience]}
            </span>
          )
        }
      </p>

      <h3
        class="mt-4 font-display text-xl leading-snug font-extrabold text-end-950 lg:text-2xl"
      >
        {data.topic}
      </h3>

      <p class="mt-2 text-sm text-ink-muted">{data.categoryLabel}</p>
    </div>

    {
      recording && (
        <span
          class="grid size-10 shrink-0 place-items-center rounded-[0.8rem] bg-teal-50 text-teal-700 ring-1 ring-teal-200"
          title="Sesión grabada"
        >
          <Icon name="circle-play" class="size-5" label="Sesión grabada" />
        </span>
      )
    }
  </div>

  {/* Herramientas de la sesión. */}
  {
    data.tools.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {data.tools.map((tool) => (
          <li class="rounded-full bg-paper px-3 py-1 text-[0.8125rem] text-ink-soft ring-1 ring-border">
            {tool}
          </li>
        ))}
      </ul>
    )
  }

  {/* Lo que cubre, cuando el tema lo enumera. */}
  {
    data.covers.length > 0 && (
      <ul class="mt-5 space-y-1.5">
        {data.covers.map((item) => (
          <li class="flex items-start gap-2.5 text-[0.9375rem] text-ink-soft">
            <Icon name="check" class="mt-1 size-3.5 shrink-0 text-teal-600" />
            {item}
          </li>
        ))}
      </ul>
    )
  }

  {/* Fecha y franjas. Si no hay fecha cerrada, se dice. */}
  <div class="mt-6 border-t border-border pt-5">
    {/* `dateLabel` es la cadena tal como se convoca ("Jueves 20 de
        agosto"); `date` solo existe para ordenar y para saber si la
        sesión ya pasó. Repetir ambas diría dos veces lo mismo. */}
    <p class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
      <span class="font-display font-bold text-end-900">{data.dateLabel}</span>
      {
        !data.date && (
          <span class="text-sm font-semibold text-clay-700">
            Fecha por confirmar
          </span>
        )
      }
    </p>

    <ul class="mt-3 flex flex-wrap gap-2">
      {
        data.groups.map((group) => (
          <li class="tabular flex items-center gap-1.5 rounded-full bg-paper px-3 py-1.5 text-[0.8125rem] font-medium text-ink-soft ring-1 ring-border">
            <Icon name="clock" class="size-3.5 opacity-60" />
            {group.label && <span class="opacity-70">{group.label}</span>}
            <span>
              {group.start}–{group.end}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-5 text-[0.9375rem] text-ink-soft">
    <span class="font-semibold text-end-900">
      {data.facilitators.length === 1 ? 'Facilita' : 'Facilitan'}:
    </span>{' '}
    {data.facilitators.join(' · ')}
  </p>

  {/* Espacio de asesoría personalizada. */}
  {
    data.support && (
      <p class="mt-3 flex items-start gap-2.5 rounded-card bg-clay-50 px-4 py-3 text-sm leading-relaxed text-ink-soft">
        <Icon name="users" class="mt-0.5 size-4 shrink-0 text-clay-700" />
        <span>
          {data.support.start && data.support.end && (
            <>
              <span class="tabular font-semibold text-clay-800">
                Asesoría de {data.support.start} a {data.support.end}
              </span>
              {data.support.host && <> · Acompaña {data.support.host}</>}
            </>
          )}
          {data.support.note}
        </span>
      </p>
    )
  }

  {/* Estado de la grabación: el eje futuro de esta sección. */}
  <div class="mt-auto pt-6">
    {
      recording ? (
        <>
          <a
            href={recording.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-control bg-teal-600 px-4 py-2.5 text-[0.9375rem] font-semibold text-white transition-colors duration-300 hover:bg-teal-700"
          >
            <Icon name="play" class="size-4" />
            Ver la grabación
            <Icon name="external" class="size-4 opacity-70" />
          </a>
          {recording.note && (
            <p class="mt-2.5 text-sm text-ink-muted">{recording.note}</p>
          )}
        </>
      ) : (
        <p
          class:list={[
            'flex items-center gap-2.5 text-sm',
            past ? 'text-clay-700' : 'text-ink-muted',
          ]}
        >
          <Icon name="video" class="size-4 shrink-0 opacity-70" />
          {past
            ? 'Grabación pendiente de publicar'
            : 'La grabación se publicará después de la sesión'}
        </p>
      )
    }

    {
      data.resources.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {data.resources.map((resource) => (
            <li>
              <a
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex items-center gap-1.5 text-sm font-semibold text-end-700"
              >
                <span class="link-underline">{resource.label}</span>
                <Icon name="external" class="size-3.5" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
