---
import Icon from '../primitives/Icon.astro';
import { getInstitutionalGroups } from '../../lib/content';
import { SITE } from '../../config/site.mjs';

/**
 * Accesos al portal institucional.
 *
 * Es lo que un docente necesita tener a mano y que hasta ahora había
 * que ir a buscar al menú del portal: convocatorias, normativa,
 * trámites. Cada enlace apunta a la página oficial —la plataforma no
 * copia el contenido, solo lo ordena y lo deja a un clic.
 *
 * Los destinos viven en `src/content/institutional-links.json` y todos
 * están tomados del propio portal, no compuestos a mano.
 */
const groups = await getInstitutionalGroups();
---

<section aria-labelledby="accesos" class="bg-paper py-16 lg:py-20">
  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <div aria-hidden="true" class="h-[3px] w-12 rounded-full bg-clay-500"></div>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div class="max-w-2xl">
        <h2
          id="accesos"
          class="font-display text-section font-extrabold text-end-900"
        >
          Accesos al portal institucional
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-ink-soft">
          Lo que publica la {SITE.institutionShort} y que necesitas a mano.
          Todos los enlaces abren en el portal oficial.
        </p>
      </div>

      <a
        href={SITE.portal.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex shrink-0 items-center gap-2 font-semibold text-clay-700"
      >
        <span class="link-underline">Ir al portal END</span>
        <Icon
          name="external"
          class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </a>
    </div>

    <div class="mt-12 grid gap-x-12 gap-y-12 lg:grid-cols-3">
      {
        groups.map((group) => (
          <section aria-labelledby={`accesos-${group.id}`}>
            <h3 id={`accesos-${group.id}`} class="eyebrow text-clay-700">
              {group.label}
            </h3>

            <ul class="mt-5 border-t border-clay-200">
              {group.links.map((link) => (
                <li class="border-b border-clay-200">
                  <a
                    href={link.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-start gap-3.5 py-4"
                  >
                    <Icon
                      name={link.data.icon}
                      class="mt-0.5 size-[18px] shrink-0 text-clay-600"
                    />

                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold text-end-900">
                        <span class="link-underline">{link.data.label}</span>
                      </span>
                      <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
                        {link.data.description}
                      </span>
                    </span>

                    <Icon
                      name={link.data.kind === 'documento' ? 'file-text' : 'external'}
                      class="mt-0.5 size-4 shrink-0 text-ink-muted transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-clay-700"
                      label={
                        link.data.kind === 'documento'
                          ? 'Documento en el portal END'
                          : 'Abre en el portal END'
                      }
                    />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
