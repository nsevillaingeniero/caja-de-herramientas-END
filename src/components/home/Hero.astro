---
import { Image } from 'astro:assets';

import Icon from '../primitives/Icon.astro';
import { SITE } from '../../config/site.mjs';
import { VISIBLE_AREAS, accent as accentStyles } from '../../lib/accents';
import stripImage from '../../assets/institutional/estudiantes-end.webp';

/**
 * Apertura de la plataforma.
 *
 * Composición centrada: antetítulo, titular, promesa y buscador en
 * un solo eje. Lo que la separa de una portada plana es el lienzo:
 * un degradado frío, una malla de puntos y tres orbes desenfocados
 * que se mueven muy despacio bajo el contenido.
 *
 * La fotografía no aparece como un rectángulo aparte. Entra como una
 * banda que desborda el contenedor de texto, se inclina un grado y
 * sostiene encima tres fichas traslúcidas con las cifras reales del
 * catálogo. Es el suelo de la composición, no una ilustración.
 */
interface Props {
  stats: { label: string; value: number }[];
}

const { stats } = Astro.props;

/**
 * La rejilla se ajusta al número de cifras: si un área se oculta, las
 * fichas restantes se reparten el ancho en vez de dejar una columna
 * vacía. Se escriben completas porque Tailwind lee el código como
 * texto y no generaría una clase compuesta en tiempo de ejecución.
 */
const statsColumns =
  stats.length >= 3
    ? 'sm:grid-cols-3'
    : stats.length === 2
      ? 'sm:grid-cols-2'
      : 'sm:grid-cols-1';
---

<section class="relative isolate overflow-hidden bg-white pb-16 md:pb-28 lg:pb-32">
  {/* ── LIENZO ───────────────────────────────────────────────
      Cuatro capas bajo el contenido: degradado frío, malla de
      puntos que se desvanece, orbes de color y un velo blanco
      que devuelve legibilidad al centro. */}
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,#ffffff_0%,#f2f7fb_40%,#e6f1fa_70%,#ffffff_100%)]"
    >
    </div>

    <div
      class="dot-grid absolute inset-0 [mask-image:radial-gradient(120%_80%_at_50%_0%,#000_20%,transparent_75%)] opacity-70"
    >
    </div>

    <span
      class="orb animate-drift-slow top-[-14rem] left-[-10rem] size-[34rem] bg-end-300/70"
    ></span>
    <span
      class="orb animate-drift top-[6rem] right-[-12rem] size-[30rem] bg-teal-300/70"
    ></span>
    <span
      class="orb animate-drift-slow bottom-[2rem] left-[26%] size-[26rem] bg-clay-300/45"
    ></span>

    <div
      class="absolute inset-x-0 top-1/4 h-1/2 bg-[radial-gradient(60%_60%_at_50%_50%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0)_100%)]"
    >
    </div>
  </div>

  {/* ── CONTENIDO ─────────────────────────────────────────── */}
  <div class="mx-auto max-w-[78rem] px-5 pt-16 sm:px-8 lg:pt-24">
    <div class="mx-auto max-w-3xl text-center">
      {/* Ficha traslúcida con punto vivo: la marca institucional
          entra como estado del producto, no como membrete. */}
      <p
        class="glass animate-rise inline-flex items-center gap-2.5 rounded-full py-2 pr-5 pl-3.5 text-sm font-semibold text-end-900"
      >
        <span class="relative flex size-2">
          <span
            class="absolute inline-flex size-full animate-ping rounded-full bg-teal-400 opacity-75"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-teal-500"
          ></span>
        </span>
        {SITE.institutionShort}
      </p>

      <h1
        class="animate-rise mt-8 font-display text-display font-extrabold text-end-950 [animation-delay:80ms]"
      >
        Todo lo que necesitas para{' '}
        <span class="relative inline-block whitespace-nowrap text-end-600">
          enseñar mejor
          {/* Trazo bajo el remate: dibujado, no un borde. */}
          <svg
            aria-hidden="true"
            viewBox="0 0 300 14"
            preserveAspectRatio="none"
            class="absolute -bottom-[0.44em] left-0 h-[0.32em] w-full text-teal-400"
          >
            <path
              d="M3 9.5C58 4 122 2.5 187 4.5c37 1.2 74 3.4 110 6"
              fill="none"
              stroke="currentColor"
              stroke-width="4.5"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>.
      </h1>

      <p
        class="animate-rise mx-auto mt-8 max-w-xl text-lg leading-relaxed text-ink-soft [animation-delay:160ms] sm:text-xl"
      >
        Explora recursos, aprende a utilizar END Digital y encuentra contenidos
        para enriquecer tus experiencias de aprendizaje.
      </p>

      {/* Buscador protagonista. Delega en el diálogo global al
          recibir foco; el halo cian confirma que está activo. */}
      <div class="animate-rise mx-auto mt-11 max-w-xl [animation-delay:240ms]">
        <label for="hero-search" class="sr-only">¿Qué necesitas hacer?</label>

        <div class="group relative">
          <div
            aria-hidden="true"
            class="absolute -inset-1.5 rounded-[1.6rem] bg-[linear-gradient(110deg,var(--color-end-400),var(--color-teal-400),var(--color-clay-300))] opacity-0 blur-lg transition-opacity duration-500 group-focus-within:opacity-45"
          >
          </div>

          <div
            class="relative flex items-center rounded-control bg-white shadow-lift ring-1 ring-border transition-shadow duration-300 group-focus-within:ring-2 group-focus-within:ring-teal-400"
          >
            <Icon
              name="search"
              class="pointer-events-none ml-5 size-5 shrink-0 text-ink-muted transition-colors duration-300 group-focus-within:text-end-600"
            />
            <input
              id="hero-search"
              type="search"
              data-search-proxy
              autocomplete="off"
              placeholder="¿Qué necesitas hacer?"
              class="w-full bg-transparent py-5 pr-4 pl-4 text-base text-ink outline-none placeholder:text-ink-muted"
            />
            <kbd
              aria-hidden="true"
              class="mr-4 hidden shrink-0 rounded-md bg-paper px-2 py-1 font-sans text-xs font-semibold text-ink-muted ring-1 ring-border sm:block"
            >
              /
            </kbd>
          </div>
        </div>

        <p class="mt-5 text-sm text-ink-muted">
          Busca herramientas, tutoriales y contenidos institucionales.
        </p>
      </div>

      {/* Atajos por área: quien ya sabe a dónde va no pasa por el
          buscador. Cada uno lleva el color de su área. */}
      <ul
        class="animate-rise mt-9 flex flex-wrap justify-center gap-2.5 [animation-delay:320ms]"
      >
        {
          VISIBLE_AREAS.map((area) => {
            const tokens = accentStyles(area.accent);

            return (
              <li>
                <a
                  href={area.href}
                  class="group flex items-center gap-2.5 rounded-full bg-white/70 py-2 pr-4 pl-3.5 text-sm font-semibold text-end-900 shadow-float ring-1 ring-white backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:shadow-lift"
                >
                  <span
                    aria-hidden="true"
                    class:list={['size-2 rounded-full', tokens.rule]}
                  />
                  {area.label}
                  <Icon
                    name="arrow"
                    class="size-3.5 text-ink-muted transition-transform duration-300 group-hover:translate-x-0.5"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  {/* ── BANDA FOTOGRÁFICA ─────────────────────────────────────
      Desborda el contenedor de texto y queda recortada por la
      sección: la fotografía no termina, se sale del cuadro. */}
  <div class="relative mt-20 lg:mt-28">
    <div class="mx-auto w-[104vw] max-w-[94rem]">
      <div
        class="reveal group relative overflow-hidden rounded-hero shadow-lift ring-1 ring-white/60 will-change-transform lg:rotate-[-0.6deg]"
      >
        <Image
          src={stripImage}
          alt="Estudiantes de la Escuela Nacional del Deporte conversando frente al aviso institucional del campus."
          widths={[768, 1086]}
          sizes="(min-width: 1024px) 86rem, 112vw"
          loading="eager"
          fetchpriority="high"
          class="zoom-soft h-56 w-full object-cover object-[center_36%] sm:h-64 lg:h-[20rem]"
        />

        {/* Velo azul: la banda pertenece a la paleta y sostiene
            el contraste de las fichas que van encima. */}
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[linear-gradient(102deg,rgba(11,42,69,0.74)_0%,rgba(11,42,69,0.28)_48%,rgba(8,119,201,0.22)_100%)]"
        >
        </div>
        <div
          aria-hidden="true"
          class="dot-grid-dark absolute inset-0 opacity-60 mix-blend-overlay"
        >
        </div>
      </div>
    </div>

    {/* Fichas de cifras: los números son los del contenido real, no
        una promesa. A partir de tablet flotan sobre el borde inferior
        de la banda, mitad dentro y mitad fuera; en móvil se apilan
        debajo, porque tres fichas apiladas taparían la fotografía. */}
    <ul
      class:list={[
        'reveal mx-auto mt-6 grid max-w-[70rem] grid-cols-1 gap-3 px-5 sm:px-8 md:absolute md:inset-x-0 md:bottom-0 md:mt-0 md:translate-y-1/2 lg:gap-5',
        statsColumns,
      ]}
    >
      {
        stats.map((stat, index) => (
          <li
            class="reveal-step glass flex items-center gap-4 rounded-card px-5 py-4 lg:px-6 lg:py-5"
            style={`--step:${index}`}
          >
            <span class="tabular font-display text-3xl font-extrabold text-end-600 lg:text-4xl">
              {stat.value}
            </span>
            <span class="text-sm leading-snug text-ink-soft">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
